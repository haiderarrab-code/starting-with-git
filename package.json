{
  "name": "unified-db-search",
  "version": "2.0.0",
  "description": "نظام البحث الموحّد في قواعد البيانات — Excel / SQLite (Electron desktop app)",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:portable": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "express": "^4.18.2",
    "playwright-core": "^1.61.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.unified.dbsearch",
    "productName": "UnifiedDBSearch",
    "files": [
      "index.html",
      "style.css",
      "app.js",
      "data-worker.js",
      "electron-main.js",
      "vendor/xlsx.full.min.js",
      "vendor/jszip.min.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
